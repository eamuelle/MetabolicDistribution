x <- met_sub[,"Bin"]
y <- met_sub[,"Per_cells"]
model <- glm(log(y) ~ x, family = gaussian())
meanlog <- mean(log(y))
sdlog <- sd(residuals(model))
R2 <- summary(lm(exp(predict(model, newdata = data.frame(x = met_sub[,"Bin"]))) ~ met_sub[,"Per_cells"]))$r.squared
qlnorm <- exp(predict(model, newdata = data.frame(x = met_sub[,"Bin"])))
fit <- cbind(rep(samples_xy[metn], length(met_sub[,"Per_cells"])),rep(met_samples[metn+183, "Set"], length(met_sub[,"Per_cells"])), met_sub[,"Per_cells"], qlnorm)
ln_param <- rbind(ln_param, data.frame("Sample" = samples_xy[metn], "meanlog" = meanlog, "sdlog" = sdlog, "AIC_ln" = AIC(model),"BIC_ln" = BIC(model), "lL_ln" = logLik(model), "R2_ln" = R2))
colnames(fit) <- c("Sample", "Set", "RSG_ab", "qlnorm")
ln_fits <- rbind(ln_fits, fit)
metn <- metn + 1
}
ln_fits <- ln_fits[-1,]
ln_fits <- subset(ln_fits, ln_fits$qlnorm != "Inf")
ln_param <- ln_param[-1,]
ln_fits <- subset(ln_fits, !(ln_fits$Sample %in% c("MD_9_D1A_A", "MD_9_D1B_A", "MD_5_D1A_A")))
CI <- data.frame("x_ci" = seq(0, 9, 0.5), "y_ci" = seq(0, 9, 0.5))
met_samples <- cbind(met_samples, ln_param[,c("meanlog", "sdlog", "AIC_ln", "BIC_ln", "lL_ln", "R2_ln")])
ln_fits$RSG_ab <- as.numeric(ln_fits$RSG_ab)
ln_fits$qlnorm <- as.numeric(ln_fits$qlnorm)
top20 <- c()
for(met1 in met_all){
quantile_cutoff <- quantile(met1$RSG_ab, 0.8)
total_activity <- sum(met1$RSG_ab)
top20_activity <- sum(subset(met1, met1$RSG_ab > quantile_cutoff)$RSG_ab)
top20_fraction <- top20_activity/total_activity
top20 <- c(top20, top20_fraction)
}
