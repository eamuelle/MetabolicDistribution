model <- lme4::lmer(data = ln_all, sdlog ~ Method + (1 | Matrix))
summary(model)
vc <- VarCorr(model)
tau2 <- vc$Matrix[1]
sigma2 <- attr(vc, "sc")^2
icc <- tau2 / (tau2 + sigma2)
model <- lme4::lmer(data = ln_all, sdlog ~ 1 + (1 | Matrix))
summary(model)
# Variance components
vc <- VarCorr(model)
tau2 <- vc$Matrix[1]
sigma2 <- attr(vc, "sc")^2
# Intraclass correlation coefficient
icc <- tau2 / (tau2 + sigma2)
model <- lme4::lmer(data = ln_all, top20 ~ 1 + (1 | Matrix))
